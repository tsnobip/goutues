{
  "name": "goutues-website",
  "namespace": false,
  "dependencies": [
    "@rescript/react",
    "sury"
  ],
  "jsx": {
    "version": 4
  },
  "ppx-flags": [
    "sury-ppx/bin"
  ],
  "sources": [
    {
      "dir": "common"
    },
    {
      "dir": "bindings"
    },
    {
      "dir": "pages",
      "subdirs": true
    },
    {
      "dir": "components",
      "subdirs": true
    },
    "layouts"
  ],
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".js",
  "warnings": {
    "error": "+101+8"
  }
}